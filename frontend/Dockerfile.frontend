# Build stage
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage
FROM nginx:alpine

# Копируем собранные файлы React
COPY --from=build /app/dist /usr/share/nginx/html

# КРИТИЧЕСКИ ВАЖНО: Копируем наш SPA-конфиг поверх дефолтного nginx
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
