import re
import logging


logger = logging.getLogger(__name__)


class FactGuard:
    """
    Проверка соответствия текста исходным фактам.
    """

    def clean(
        self,
        text: str,
        source_text: str
    ) -> str:

        if not source_text:
            return text


        forbidden_patterns = [
            r"крупнейшая компания",
            r"лидер рынка",
            r"революцион",
            r"значительно улучш",
            r"открывает новые возможности",
            r"будет использоваться",
            r"поможет в разработке",
            r"миллионы пользователей",
        ]


        for pattern in forbidden_patterns:

            text = re.sub(
                pattern,
                "",
                text,
                flags=re.IGNORECASE
            )


        return text.strip()